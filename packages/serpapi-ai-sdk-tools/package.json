{
  "name": "serpapi-ai-sdk-tools",
  "version": "0.1.0",
  "description": "Ready-made SerpApi search tools for the Vercel AI SDK: web, news, maps, shopping, flights and hotels. Typed inputs validated before a request is sent, compact token-efficient results, and your API key never leaves.",
  "keywords": [
    "serpapi",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai",
    "llm",
    "agent",
    "tools",
    "tool-calling",
    "function-calling",
    "search",
    "search-api",
    "serp",
    "web-search",
    "google-search",
    "google-flights",
    "google-hotels",
    "google-maps",
    "google-shopping",
    "google-news",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sumit642-ai",
  "homepage": "https://github.com/Sumit642-ai/serpapi-ai-sdk-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumit642-ai/serpapi-ai-sdk-tools.git",
    "directory": "packages/serpapi-ai-sdk-tools"
  },
  "bugs": {
    "url": "https://github.com/Sumit642-ai/serpapi-ai-sdk-tools/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ai": "^7.0.102",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^18.17.0 || >=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
