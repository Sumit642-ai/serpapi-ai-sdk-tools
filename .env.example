# Copy this file to .env and fill in your own keys.
#
#   PowerShell:  Copy-Item .env.example .env
#
# .env is git-ignored. Never commit real keys. Placeholders only in this file.

# --- Required to record fixtures (npm run fixtures) and to run the chat demo ---
# Free key: https://serpapi.com/manage-api-key
# The package also accepts SERPAPI_KEY if you already use that name.
SERPAPI_API_KEY=your_serpapi_key_here

# --- Required only for the chat demo in examples/chat ---
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# --- Optional: which Gemini model the chat demo uses ---
# Leave unset to use the default below.
#
# Measured time to the first streamed token on a free key, asking for one word:
#   gemini-3.6-flash       2.1s   <- the default, and the fastest that works
#   gemini-3.1-flash-lite  3.8s
#   gemini-3.5-flash      13.8s   slow, but works
#   gemini-3.8-flash       timed out after 30s
#   gemini-flash-latest    timed out after 30s
#   gemini-2.5-flash       404, no longer available to new keys
# A slow model makes the demo look broken, so prefer the fast one.
DEMO_MODEL=gemini-3.6-flash
